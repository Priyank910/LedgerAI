{
  "name": "ledger-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "worker:dev": "wrangler dev --port 8787",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/noto-sans": "^5.2.5",
    "@fontsource/noto-sans-devanagari": "^5.2.5",
    "@fontsource/noto-sans-gujarati": "^5.2.5",
    "@fontsource/noto-serif": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "lucide-react": "^0.545.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@tauri-apps/cli": "^2.7.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.166.0"
  }
}
