# Copy to .env. Never commit .env. Leave a value blank to keep that feature off.
# The app works fully on this device with every value empty.

# Cloudflare Worker URL. Sign-in, sync, and live AI use this absolute address.
# Release builds use the same URL when VITE_API_URL is not set as a repository variable or secret.
# Clear it for `npm run dev` if you want Vite to proxy /api to local wrangler on port 8787.
VITE_API_URL=https://ledger-ai.priyank-chavda.workers.dev

# Dev/tests only. "mock" answers from the on-device phrase tool-caller (no network,
# no API key, limited phrases). Leave empty in production so questions go to OpenRouter.
VITE_LLM_MODE=
