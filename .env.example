# Copy to .env. Never commit .env. Leave a value blank to keep that feature off.
# The app works fully on this device with every value empty.

# Supabase project (Auth + Postgres). The anon key is public; Row Level Security
# limits each signed-in person to their own rows. Do not put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. When empty, a signed-in app calls the Supabase edge function "ai-chat".
# Set this only if the Gemini proxy lives somewhere else.
VITE_AI_PROXY_URL=

# Dev/tests only. "mock" answers from the on-device phrase tool-caller (no network,
# no API key, limited phrases). Leave empty in production so questions go to Gemini.
VITE_LLM_MODE=

# Server-side only. Do NOT prefix with VITE_. Vite's dev server and the Supabase
# edge function read this. It is never bundled into the Android or Windows app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
