# Copy to .env. Never commit .env. Leave a value blank to keep that feature off.
# The app works fully on this device with every value empty.

# Cloudflare Worker URL. Required for sign-in, sync, and live AI on Android and Windows.
# Example: https://ledger-ai.<account>.workers.dev
# Leave empty in `npm run dev`: the Vite server proxies /api to wrangler on port 8787.
# Native builds cannot use a relative /api path. Put the absolute URL here and rebuild.
VITE_API_URL=

# Dev/tests only. "mock" answers from the on-device phrase tool-caller (no network,
# no API key, limited phrases). Leave empty in production so questions go to Gemini.
VITE_LLM_MODE=
